  "components": [
    {
      "name": "Current-set tile",
      "kind": "card",
      "refersTo": "tile-accent",
      "description": "The signature: weight and reps at poster size on the owner's accent, with steppers and the primary check.",
      "html": "<div class=\"ds-wrap\" dir=\"rtl\"><div class=\"ds-tile\"><span class=\"ds-tile-title\">סט 2 מתוך 3</span><div class=\"ds-nums\"><div class=\"ds-num\"><span class=\"ds-numeral\">8</span><span class=\"ds-unit\">חזרות</span><div class=\"ds-steps\"><button class=\"ds-step\" aria-label=\"הוספה\">+</button><button class=\"ds-step\" aria-label=\"הפחתה\">−</button></div></div><span class=\"ds-times\">×</span><div class=\"ds-num\"><span class=\"ds-numeral\">27.5</span><span class=\"ds-unit\">ק״ג</span><div class=\"ds-steps\"><button class=\"ds-step\" aria-label=\"הוספה\">+</button><button class=\"ds-step\" aria-label=\"הפחתה\">−</button></div></div></div><button class=\"ds-check\" aria-pressed=\"false\" aria-label=\"סיום סט\"><svg viewBox=\"0 0 24 24\" width=\"38\" height=\"38\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></button></div></div>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-wrap{background:var(--app-ground);padding:16px} .ds-tile{position:relative;min-height:290px;padding:16px 8px 12px;border-radius:24px;background:var(--app-accent);color:var(--app-on-accent)} .ds-tile-title{display:block;padding-inline:8px;font-size:15px;line-height:20px} .ds-nums{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);column-gap:4px;margin-top:14px} .ds-num{display:flex;flex-direction:column;align-items:center} .ds-numeral{font-size:118px;font-weight:200;line-height:106px;letter-spacing:-.02em} .ds-times{font-size:40px;font-weight:200;line-height:106px} .ds-unit{font-size:15px;line-height:20px} .ds-steps{display:flex;margin-top:8px} .ds-step{width:44px;height:48px;border:0;border-radius:12px;background:none;color:inherit;font:inherit;font-size:34px;font-weight:200;cursor:pointer} .ds-step:active{background:rgba(0,0,0,.12)} .ds-step:focus-visible{outline:2px solid #000;outline-offset:-2px} .ds-check{position:absolute;inset-block-end:12px;inset-inline-end:12px;display:grid;place-items:center;width:72px;height:72px;border:0;border-radius:50%;background:var(--app-on-accent);color:var(--app-accent);cursor:pointer} .ds-check:active{opacity:.6} .ds-check:focus-visible{outline:2px solid #000;outline-offset:2px} .ds-check[aria-pressed=true]{color:var(--app-done)}"
    },
    {
      "name": "Set row",
      "kind": "custom",
      "refersTo": "check-row",
      "description": "Done and waiting sets as one text row: Note label, thin Heading value, bare 48px check.",
      "html": "<div class=\"ds-wrap\" dir=\"rtl\"><div class=\"ds-row ds-done\"><span class=\"ds-set-title\">סט 1</span><span class=\"ds-set-value\">8 × 27.5</span><button class=\"ds-row-check\" aria-pressed=\"true\" aria-label=\"בוצע\"><svg viewBox=\"0 0 24 24\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></button></div><div class=\"ds-row\"><span class=\"ds-set-title\">סט 3</span><span class=\"ds-set-value\">8 × 27.5</span><button class=\"ds-row-check\" aria-pressed=\"false\" aria-label=\"סיום סט\"><span class=\"ds-ring\"></span></button></div></div>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-wrap{background:var(--app-ground);padding:8px 0} .ds-row{display:flex;align-items:center;min-height:48px;padding-inline:16px} .ds-set-title{flex:0 0 52px;font-size:15px;color:var(--app-label-secondary)} .ds-set-value{flex:1;font-size:30px;font-weight:200;line-height:48px;color:var(--app-label-secondary)} .ds-done .ds-set-value{color:var(--app-label)} .ds-row-check{display:grid;place-items:center;width:48px;height:48px;margin-inline:12px 24px;border:0;background:none;color:var(--app-label-secondary);cursor:pointer} .ds-row-check[aria-pressed=true]{color:var(--app-done)} .ds-row-check:active{opacity:.6} .ds-row-check:focus-visible{outline:2px solid var(--app-accent);outline-offset:2px} .ds-ring{width:24px;height:24px;border:1.5px solid var(--app-label-secondary);border-radius:50%}"
    },
    {
      "name": "Text actions",
      "kind": "button",
      "refersTo": "text-action",
      "description": "Bare accent words, 48px tall; the app's default button.",
      "html": "<div class=\"ds-wrap\" dir=\"rtl\"><button class=\"ds-text-action\">דלג</button><button class=\"ds-text-action\">הוספת סט</button><button class=\"ds-text-action\">הוספת הערה</button></div>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-wrap{display:flex;justify-content:space-between;background:var(--app-ground);padding:4px} .ds-text-action{min-height:48px;padding:0 12px;border:0;border-radius:12px;background:none;color:var(--app-accent);font:inherit;font-size:17px;cursor:pointer} .ds-text-action:active{opacity:.6} .ds-text-action:focus-visible{outline:2px solid var(--app-accent);outline-offset:2px}"
    },
    {
      "name": "Start-workout bar",
      "kind": "button",
      "refersTo": "tile-accent",
      "description": "The one filled button: full-width accent bar in the bottom toolbar.",
      "html": "<div class=\"ds-wrap\" dir=\"rtl\"><button class=\"ds-start\">התחלת אימון</button></div>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-wrap{background:var(--app-ground);padding:8px 16px} .ds-start{width:100%;height:64px;padding:0 20px;border:0;border-radius:20px;background:var(--app-accent);color:var(--app-on-accent);font:inherit;font-size:22px;cursor:pointer} .ds-start:active{background:color-mix(in srgb,var(--app-accent) 88%,#000)} .ds-start:focus-visible{outline:2px solid var(--app-accent);outline-offset:2px}"
    },
    {
      "name": "Area tiles",
      "kind": "card",
      "refersTo": "area-tile",
      "description": "Quiet graphite tiles in a three-column grid; the selected one fills with the accent.",
      "html": "<div class=\"ds-wrap\" dir=\"rtl\"><button class=\"ds-area ds-area-on\" aria-pressed=\"true\"><span class=\"ds-area-name\">רגליים</span><span class=\"ds-area-count\">12</span></button><button class=\"ds-area\" aria-pressed=\"false\"><span class=\"ds-area-name\">גב</span><span class=\"ds-area-count\">9</span></button><button class=\"ds-area\" aria-pressed=\"false\"><span class=\"ds-area-name\">חזה</span><span class=\"ds-area-count\">7</span></button></div>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-wrap{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;background:var(--app-ground);padding:16px} .ds-area{display:flex;align-items:flex-end;justify-content:space-between;min-height:92px;padding:10px 12px 8px;border:0;border-radius:16px;background:var(--app-fill-quiet);color:var(--app-label);font:inherit;text-align:start;cursor:pointer;transition:background-color 160ms ease-out,color 160ms ease-out} .ds-area:active:not(.ds-area-on){background:var(--app-fill-raised)} .ds-area:focus-visible{outline:2px solid var(--app-accent);outline-offset:2px} .ds-area-on{background:var(--app-accent);color:var(--app-on-accent)} .ds-area-name{font-size:15px;line-height:20px} .ds-area-count{font-size:30px;font-weight:200;line-height:1;color:var(--app-label-secondary)} .ds-area-on .ds-area-count{color:inherit} @media (prefers-reduced-motion:reduce){.ds-area{transition:none}}"
    },
    {
      "name": "Week strip",
      "kind": "custom",
      "refersTo": "day-tile-gym",
      "description": "Seven 12px day cells: accent for gym, raised graphite for activity, dim when empty, a white ring for today.",
      "html": "<div class=\"ds-wrap\" dir=\"rtl\"><span class=\"ds-day ds-gym\"><small>א׳</small>8</span><span class=\"ds-day\"><small>ב׳</small>9</span><span class=\"ds-day ds-act\"><small>ג׳</small>10</span><span class=\"ds-day ds-today\"><small>ד׳</small>11</span><span class=\"ds-day ds-future\"><small>ה׳</small>12</span><span class=\"ds-day ds-future\"><small>ו׳</small>13</span><span class=\"ds-day ds-future\"><small>ש׳</small>14</span></div>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-wrap{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px;background:var(--app-ground);padding:16px} .ds-day{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;height:58px;border-radius:12px;color:var(--app-label-dim);font-size:24px;font-weight:300;line-height:28px} .ds-day small{font-size:11px;line-height:14px;color:var(--app-label-secondary)} .ds-gym{background:var(--app-accent);color:var(--app-on-accent)} .ds-act{background:var(--app-fill-raised);color:var(--app-label)} .ds-gym small,.ds-act small{color:inherit} .ds-today{border:1.5px solid var(--app-label);color:var(--app-label)} .ds-future,.ds-future small{color:rgba(235,235,245,.3)}"
    },
    {
      "name": "Back-to-current pill",
      "kind": "chip",
      "refersTo": "pill-back",
      "description": "The only pill: graphite, accent text, fully round.",
      "html": "<div class=\"ds-wrap\" dir=\"rtl\"><button class=\"ds-pill\">חזרה לתרגיל הנוכחי</button></div>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-wrap{display:flex;justify-content:center;background:var(--app-ground);padding:8px} .ds-pill{min-height:44px;padding:10px 20px;border:0;border-radius:999px;background:var(--app-fill-quiet);color:var(--app-accent);font:inherit;font-size:15px;cursor:pointer} .ds-pill:active{background:var(--app-fill-raised)} .ds-pill:focus-visible{outline:2px solid var(--app-accent);outline-offset:2px}"
    },
    {
      "name": "Stepper",
      "kind": "input",
      "refersTo": "stepper",
      "description": "Translucent iOS fill with two 48 x 44px halves.",
      "html": "<div class=\"ds-wrap\" dir=\"rtl\"><span class=\"ds-value\">3</span><div class=\"ds-stepper\"><button class=\"ds-half\" aria-label=\"הוספה\">+</button><button class=\"ds-half\" aria-label=\"הפחתה\">−</button></div></div>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-wrap{display:flex;align-items:center;gap:12px;background:var(--app-fill-quiet);padding:16px;border-radius:16px} .ds-value{min-width:2ch;font-size:17px;text-align:center;color:var(--app-label-secondary)} .ds-stepper{display:flex;border-radius:12px;background:var(--app-fill)} .ds-half{width:48px;height:44px;border:0;border-radius:12px;background:none;color:var(--app-label);font:inherit;font-size:22px;cursor:pointer;transition:background-color 150ms ease-out} .ds-half:active{background:var(--app-fill)} .ds-half:focus-visible{outline:2px solid var(--app-accent);outline-offset:-2px} .ds-half:disabled{color:rgba(235,235,245,.3)}"
    },
    {
      "name": "Tab bar",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "iOS tab bar on black, no border; selected tab in the accent. Icon squares stand in for the app's own tab icons.",
      "html": "<nav class=\"ds-tabs\" dir=\"rtl\"><a class=\"ds-tab\" href=\"#\">ציר זמן</a><a class=\"ds-tab ds-tab-on\" aria-current=\"page\" href=\"#\">יומי</a><a class=\"ds-tab\" href=\"#\">אימונים</a><a class=\"ds-tab\" href=\"#\">תרגילים</a></nav>",
      "css": ":host{--app-accent:#00aba9;--app-on-accent:#000;--app-ground:#000;--app-fill-quiet:#1c1c1e;--app-fill-raised:#2c2c2e;--app-fill:rgba(118,118,128,.24);--app-label:#fff;--app-label-secondary:#98989d;--app-label-dim:#6e6e73;--app-done:#30d158;font-family:'Heebo Variable','Heebo',-apple-system,'Arial Hebrew',sans-serif;font-variant-numeric:tabular-nums} .ds-tabs{display:grid;grid-template-columns:repeat(4,1fr);background:var(--app-ground);padding:8px 0 4px} .ds-tab{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:11px;color:var(--app-label-secondary);text-decoration:none} .ds-tab::before{content:'';width:24px;height:24px;border-radius:6px;background:currentColor;opacity:.9} .ds-tab-on{color:var(--app-accent)} .ds-tab:focus-visible{outline:2px solid var(--app-accent);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Type Tiles",
    "overview": "The numbers are the interface. Weight and reps sit at poster size, thin Heebo on one flat tile of the owner's accent colour, over a ground that is pure black on every screen and in every state. Everything else steps back: the done set is one grey text row, the next set is another, actions are bare accent words, and the next exercise's name waits at display size in dim grey, cropped by the screen edge. The world borrows the Metro typographic-tile vocabulary (type as the main material, flat colour fields, no ornament) and rounds the tiles to suit the owner.\n\nDensity is low where the owner reads at arm's length and normal where they manage things. Hierarchy comes from size and weight of type, from the black / graphite / raised tonal steps, and from the single accent; never from lines, shadows or bar backgrounds. Navigation, sheets, action sheets, the tab bar and controls stay iOS-standard (Ionic in iOS mode); only the look is the app's own. The interface is Hebrew and right-to-left throughout.",
    "keyCharacteristics": [
      "Always dark: a pure black ground, no light mode, no appearance setting.",
      "Heebo Variable, bundled with the app; weight 200 for every numeral and all type from 30px up, 300 at 22 to 26px, 400 for small text.",
      "One accent, chosen by the owner from six; used as flat fills with black text on them, or as the colour of text actions.",
      "Rounded flat tiles (12 / 16 / 24px) on tonal graphite steps; no borders, dividers, shadows or bar backgrounds.",
      "Tabular numerals everywhere."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "The owner's accent is the only brand hue on screen. Green means done, coral means delete, drill colours label drills; nothing else gets colour.",
        "section": "colors"
      },
      {
        "name": "The Black-On-Accent Rule",
        "body": "Text on any accent or drill fill is black, never white. Six accents of different lightness stay legible only because the text colour never changes.",
        "section": "colors"
      },
      {
        "name": "The Large Dim Rule",
        "body": "Label Dim (#6e6e73) is used only for text 24px and up. Anything smaller that needs to be quiet uses Label Secondary (#98989d).",
        "section": "colors"
      },
      {
        "name": "The Thin From Thirty Rule",
        "body": "Weight 200 appears only at 30px and above; every numeral that size is 200. Below 30px nothing is thinner than 300, and below 22px everything is 400.",
        "section": "typography"
      },
      {
        "name": "The Size Is Hierarchy Rule",
        "body": "Rank is carried by size and weight steps, never by bold, colour fills behind text or uppercase. Weight 600 is reserved for the one warning line (a skipped exercise).",
        "section": "typography"
      },
      {
        "name": "The Tonal Step Rule",
        "body": "To lift something, move it one graphite step; to press it, move it one more or drop its opacity to 0.6 to 0.7. Never add a shadow, border or blur.",
        "section": "elevation"
      },
      {
        "name": "The No-Line Rule",
        "body": "No dividers, hairlines, toolbar or tab bar borders, and no bar backgrounds. Lists separate rows with space alone.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the ground pure black (#000000) on every page and Sheet Graphite (#1c1c1e) in every sheet, with Raised Graphite (#2c2c2e) for panels inside sheets.",
      "Do read the accent from its token (`--app-accent` / `--ion-color-primary`) so the owner's choice of six reaches every surface; put black text on it.",
      "Do set numerals and all type 30px and up in Heebo weight 200, with tabular numerals.",
      "Do use Label Secondary (#98989d) for small quiet text and keep Label Dim (#6e6e73) for text 24px and up.",
      "Do use Done Green (#30d158) only for done, and the type-size ladder (132 / 56 / 46 / 30 / 22 / 17 / 15 / 13px) for rank.",
      "Do round every tile and control (12 / 16 / 24px) and keep tap targets at least 44pt.",
      "Do switch off every transition and animation under reduce-motion."
    ],
    "donts": [
      "Don't add a light mode, an appearance setting or a token-swapped light theme; a token swap was tried and rejected.",
      "Don't use borders, dividers, hairlines, shadows or bar backgrounds; strokes appear only as state rings.",
      "Don't use decorative gradients. The only gradient is the black scrim over the owner's background photo on the live screen, there for legibility.",
      "Don't put white text on the accent or on a drill colour.",
      "Don't use weight 200 below 30px, bold for hierarchy, or uppercase.",
      "Don't introduce a second brand hue, or use drill colours outside drill labels.",
      "Don't return to stock iOS grouped lists or dark cards holding a set table for the live screen.",
      "Don't set square tiles or edge-to-edge blocks."
    ]
  }
}
